{
  "name": "pullsize",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_als"],
  "upload_source_maps": true,

  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },

  "observability": {
    "enabled": true,
  },

  "env": {
    "beta": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
    },
  },
}
